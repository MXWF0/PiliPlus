@@ -0,0 +1,43 @@
+import 'package:flutter/widgets.dart';
+
+import 'material.dart';
+import 'theme.dart';
+import 'theme_data.dart';
+
+enum SurfaceMaterialKind { dialog, menu, bottomSheet, navigationBar, floatingActionButton, appBar }
+
+typedef SurfaceMaterialBuilder = Widget Function(
+  BuildContext context,
+  SurfaceMaterialKind kind,
+  Material material,
+);
+
+/// Application-owned treatment for shared floating surfaces.
+class SurfaceMaterialTheme extends ThemeExtension<SurfaceMaterialTheme> {
+  const SurfaceMaterialTheme({required this.builder, this.enabled = false});
+
+  final bool enabled;
+
+  final SurfaceMaterialBuilder builder;
+
+  @override
+  SurfaceMaterialTheme copyWith({SurfaceMaterialBuilder? builder, bool? enabled}) =>
+      SurfaceMaterialTheme(builder: builder ?? this.builder, enabled: enabled ?? this.enabled);
+
+  @override
+  SurfaceMaterialTheme lerp(SurfaceMaterialTheme? other, double t) =>
+      other == null || t < .5 ? this : other;
+}
+
+class SurfaceMaterial extends StatelessWidget {
+  const SurfaceMaterial({super.key, required this.kind, required this.material});
+
+  final SurfaceMaterialKind kind;
+  final Material material;
+
+  @override
+  Widget build(BuildContext context) {
+    final builder = Theme.of(context).extension<SurfaceMaterialTheme>()?.builder;
+    return builder == null ? material : builder(context, kind, material);
+  }
+}
